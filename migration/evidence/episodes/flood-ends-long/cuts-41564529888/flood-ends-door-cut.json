 "sentences": [
  {
   "segment": "n31",
   "text": "Most miss this:",
   "start": 0.251,
   "end": 1.721,
   "line": 31,
   "line_kind": "insight"
  },
  {
   "segment": "n31",
   "text": "Noah saw dry ground and still waited.",
   "start": 1.907,
   "end": 4.605,
   "line": 31,
   "line_kind": "insight"
  },
  {
   "segment": "n31",
   "text": "He stepped out when God said go.",
   "start": 4.79,
   "end": 7.202,
   "line": 31,
   "line_kind": "insight"
  },
  {
   "segment": "n31",
   "text": "The One who shut the door opened it.",
   "start": 7.388,
   "end": 9.801,
   "line": 31,
   "line_kind": "insight"
  },
  {
   "segment": "n32",
   "text": "Two months more, until the earth was fully dry.",
   "start": 10.151,
   "end": 13.287,
   "line": 32,
   "line_kind": "story"
  },
  {
   "segment": "n32",
   "text": "Then, at last, the voice came.",
   "start": 13.467,
   "end": 15.536,
   "line": 32,
   "line_kind": "story"
  },
  {
   "segment": "n32",
   "text": "Not a shout.",
   "start": 15.716,
   "end": 16.996,
   "line": 32,
   "line_kind": "story"
  },
  {
   "segment": "n32",
   "text": "A word.",
   "start": 17.176,
   "end": 18.243,
   "line": 32,
   "line_kind": "story"
  },
  {
   "segment": "n32",
   "text": "And with it, the door that no one else could open.",
   "start": 18.423,
   "end": 21.602,
   "line": 32,
   "line_kind": "story"
  },
  {
   "segment": "n33",
   "text": "And God spake unto Noah, saying,",
   "start": 21.952,
   "end": 24.405,
   "kind": "scripture",
   "reference": "Genesis 8:15 (KJV)",
   "line": 33,
   "line_kind": "scripture"
  },
  {
   "segment": "n34",
   "text": "And Noah went forth, and his sons, and his wife, and his sons’ wives with him:",
