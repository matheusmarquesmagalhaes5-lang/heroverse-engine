 "sentences": [
  {
   "segment": "r00",
   "text": "God did not hang that rainbow because Noah was perfect, and the story says so plainly.",
   "start": 0.3,
   "end": 5.939
  },
  {
   "segment": "r01",
   "text": "He failed again, the way people do.",
   "start": 6.152,
   "end": 8.377
  },
  {
   "segment": "r01",
   "text": "Still, God hung up His own bow.",
   "start": 8.377,
   "end": 10.602
  },
  {
   "segment": "r02",
   "text": "So if you are waiting on God tonight, you are not forgotten.",
   "start": 10.747,
   "end": 15.123
  },
  {
   "segment": "r02",
   "text": "You are carried.",
   "start": 15.123,
   "end": 16.217
  },
  {
   "segment": "r03",
   "text": "Before any rainbow, Noah did one thing first on dry ground, and it still stops me every time.",
   "start": 16.302,
   "end": 23.569
  },
  {
   "segment": "r03",
   "text": "Watch what it was.",
   "start": 23.569,
   "end": 25.184
  }
 ],
