 "sentences": [
  {
   "segment": "n10",
   "text": "The ark scraped rock and stopped.",
   "start": 0.241,
   "end": 2.545,
   "line": 10,
   "line_kind": "story"
  },
  {
   "segment": "n10",
   "text": "Everyone froze.",
