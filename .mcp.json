{
  "mcpServers": {
    "heroverse-pavo": {
      "command": "uv",
      "args": [
        "run",
        "--script",
        "migration/integrations/pavo/server.py"
      ],
      "env": {
        "PAVO_TOKEN": "${PAVO_TOKEN:-}"
      }
    },
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@0.0.83",
        "--headless",
        "--isolated",
        "--browser",
        "chromium",
        "--executable-path",
        "${PW_CHROME:-/opt/pw-browsers/chromium}"
      ]
    },
    "tubealfred": {
      "type": "http",
      "url": "https://mcp.tubealfred.com/"
    },
    "chrome-devtools": {
      "command": "npx",
      "args": [
        "-y",
        "chrome-devtools-mcp@1.12.0",
        "--headless",
        "--isolated",
        "--no-usage-statistics",
        "--executable-path",
        "${PW_CHROME:-/opt/pw-browsers/chromium}"
      ]
    }
  }
}
